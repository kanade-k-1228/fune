{
  "name": "fune-data",
  "version": "0.0.0",
  "description": "船旅データ (航路・港) と TypeScript 型/zod スキーマ",
  "type": "module",
  "main": "./dist/types/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./schema": {
      "types": "./dist/types/schema.d.ts",
      "import": "./dist/types/schema.js"
    },
    "./ports": "./dist/data/ports.json",
    "./lines": "./dist/data/lines.json",
    "./data/lines/*.yaml": "./data/lines/*.yaml",
    "./data/ports/*.yaml": "./data/ports/*.yaml"
  },
  "files": [
    "dist",
    "types",
    "scripts",
    "data",
    "tsconfig.build.json"
  ],
  "scripts": {
    "dev": "tsx scripts/server.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/build.ts",
    "validate": "tsx scripts/validate.ts",
    "update": "tsx --env-file=.env scripts/update.ts",
    "check": "biome check .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^25.9.9",
    "ts-to-zod": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
